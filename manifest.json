{
    "manifest_version": 3,
    "name": "JustMarketplace",
    "version": "0.1.0",
    "description": "A minimal Chrome extension that restricts Facebook to Marketplace.",

    "permissions": [
        "declarativeNetRequest"
    ],

    "host_permissions": [
        "https://www.facebook.com/*"
    ],

    "content_scripts": [
        {
            "matches": [
                "https://www.facebook.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],

    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "facebook_rules",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    }
}