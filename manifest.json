{
    "manifest_version": 3,
    "name": "JustMarketplace",
    "version": "0.1.0",
    "description": "A minimal Chrome extension that restricts Facebook to Marketplace.",

    "content_scripts": [
        {
            "matches": [
                "https://www.facebook.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ]
}